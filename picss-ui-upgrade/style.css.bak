:root{color-scheme:light;--bg:#f4f1eb;--surface:#fbfaf7;--ink:#242722;--muted:#85877f;--accent:#b95f43;--accent-soft:#f0dfd5;--ease:cubic-bezier(.2,.75,.25,1);--radius:19px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:var(--bg);color:var(--ink);font-family:"DM Sans",sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}button,input,select{font:inherit}a{color:inherit}.ambient{position:absolute;z-index:-1;pointer-events:none;border-radius:50%;filter:blur(2px)}.ambient-one{width:430px;height:430px;top:90px;right:-210px;background:radial-gradient(circle,#dce3d8,transparent 68%)}.ambient-two{width:360px;height:360px;top:650px;left:-230px;background:radial-gradient(circle,#f0dfd5,transparent 70%)}.topbar{height:76px;padding:0 clamp(22px,6vw,92px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ded9cf;background:#f4f1ebc7;backdrop-filter:blur(18px);position:relative;z-index:2}.brand,.footer-brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font:800 22px Manrope,sans-serif;letter-spacing:-1.2px}.brand-mark{width:31px;height:31px;display:grid;place-items:center;border-radius:11px;background:var(--ink);color:#f8f4eb;font:800 21px Manrope,sans-serif;letter-spacing:-2px;padding:0 2px 3px 0}.brand-period,.footer-brand span,.viewer-brand span{color:var(--accent)}.topbar-right{display:flex;align-items:center;gap:30px}.live-indicator{display:flex;align-items:center;gap:9px;color:#777970;font-size:9px;font-weight:700;letter-spacing:1.65px}.live-indicator span{width:7px;height:7px;border-radius:50%;background:#829a78;box-shadow:0 0 0 4px #829a7821}.about-link{text-decoration:none;font-size:12px;font-weight:600;color:#5e615a}.about-link:hover{color:var(--accent)}.page-shell{width:min(1390px,88%);margin:0 auto}.hero{min-height:405px;padding:78px 2px 72px;display:flex;align-items:center;justify-content:space-between}.eyebrow,.section-kicker{margin:0;color:var(--accent);font-size:9px;font-weight:700;letter-spacing:2px}.eyebrow{display:flex;align-items:center;gap:11px}.eyebrow-line{width:24px;height:1px;background:var(--accent)}.hero h1{margin:24px 0 18px;font:600 clamp(55px,7.2vw,96px)/.99 Manrope,sans-serif;letter-spacing:-6px}.hero h1 span{color:var(--accent);font-weight:500}.hero-description{max-width:370px;margin:0;color:#777970;font-size:14px;line-height:1.8}.hero-aside{display:flex;flex-direction:column;align-items:center;gap:18px;margin:24px 8% 0 0}.hero-aside p{margin:0;color:#85877f;text-align:center;font-size:10px;line-height:1.7;letter-spacing:.4px}.hero-orbit{width:142px;height:142px;border-radius:50%;border:1px solid #d9d9cc;display:grid;place-items:center;position:relative;animation:orbit-breathe 7s ease-in-out infinite}.hero-orbit:before,.hero-orbit:after{content:"";position:absolute;border-radius:50%;border:1px solid #e1d8ca}.hero-orbit:before{inset:12px}.hero-orbit:after{inset:26px;border-style:dashed;opacity:.7}.orbit-core{width:54px;height:54px;border-radius:19px;display:grid;place-items:center;background:var(--accent);color:#fff9f1;font:800 27px Manrope,sans-serif;letter-spacing:-2px;box-shadow:0 8px 20px #b95f432e}.orbit-dot{position:absolute;width:9px;height:9px;border-radius:50%;background:#829a78;top:14px;right:21px;z-index:1;box-shadow:0 0 0 5px #829a7821}.collection{padding:20px 0 90px}.collection-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:25px}.collection-heading h2{margin:9px 0 0;font:600 clamp(22px,3vw,29px) Manrope,sans-serif;letter-spacing:-1.2px}.photo-count{margin:0 2px 4px;color:var(--muted);font-size:11px}.toolbar{min-height:68px;padding:10px 13px 10px 18px;display:flex;align-items:center;justify-content:space-between;gap:18px;border:1px solid #e2ddd3e6;border-radius:18px;background:#fbfaf7d1;box-shadow:0 5px 20px #2d292008;margin-bottom:27px}.search-box{min-width:0;width:min(430px,65%);display:flex;align-items:center;gap:12px;color:#85877f}.search-box svg{width:18px;height:18px;flex:0 0 auto;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round}.search-box input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--ink);font-size:12px}.search-box input::placeholder{color:#9b9c95}.search-box kbd{border:1px solid #e6e2d9;border-radius:6px;padding:3px 7px;color:#999a92;background:#f7f5ef;font:10px "DM Sans",sans-serif}.toolbar-right{display:flex;align-items:center;gap:12px}.sort-label{color:#a0a097;font-size:8px;font-weight:700;letter-spacing:1.5px}.select-wrap{position:relative}.select-wrap:after{content:"";position:absolute;right:2px;top:7px;width:6px;height:6px;border-right:1.5px solid #777970;border-bottom:1.5px solid #777970;transform:rotate(45deg);pointer-events:none}.select-wrap select{appearance:none;border:0;outline:0;padding:5px 18px 5px 2px;color:#565951;background:transparent;font-size:11px;font-weight:600;cursor:pointer}.gallery{columns:4 220px;column-gap:19px;min-height:120px}.photo-card{display:inline-block;width:100%;margin:0 0 20px;padding:0;border:0;background:transparent;color:inherit;text-align:left;cursor:zoom-in;break-inside:avoid;border-radius:var(--radius);opacity:0;transform:translateY(18px) scale(.985);animation:card-enter .65s var(--ease) forwards;animation-delay:var(--delay,0ms)}.photo-card-inner{overflow:hidden;border-radius:var(--radius);background:var(--surface);box-shadow:0 2px 8px #2a261d0a;transition:transform .35s var(--ease),box-shadow .35s var(--ease)}.photo-card:hover .photo-card-inner,.photo-card:focus-visible .photo-card-inner{transform:translateY(-5px);box-shadow:0 20px 46px #2c271d21}.photo-image-wrap{overflow:hidden;background:#e6e3db;position:relative}.photo-card img{display:block;width:100%;height:auto;min-height:115px;object-fit:cover;transition:transform .65s var(--ease),filter .4s ease}.photo-card:hover img{transform:scale(1.045)}.photo-card img.image-failed{min-height:180px;opacity:.4;object-fit:contain}.photo-card-info{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 15px 14px}.photo-title{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:600 12px Manrope,sans-serif;letter-spacing:-.15px}.photo-date{flex:0 0 auto;color:#999a92;font-size:9px}.photo-card:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.loading-state{display:flex;align-items:center;gap:12px;padding:28px 0;color:var(--muted);font-size:12px}.loader{width:17px;height:17px;border:2px solid #dedbd2;border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite}.empty-state,.error-state{text-align:center;padding:65px 20px 85px;color:var(--muted)}.empty-symbol,.error-icon{display:inline-grid;place-items:center;width:48px;height:48px;border-radius:17px;background:var(--accent-soft);color:var(--accent);font:26px Manrope,sans-serif}.empty-state h3,.error-state h2{margin:17px 0 7px;color:var(--ink);font:600 19px Manrope,sans-serif}.empty-state p,.error-state p{font-size:12px}.text-button{border:0;background:transparent;color:var(--accent);font-size:12px;font-weight:700;cursor:pointer;padding:8px}.primary-button{margin-top:12px;border:0;border-radius:999px;padding:11px 20px;background:var(--ink);color:white;font-size:11px;font-weight:600;cursor:pointer;transition:transform .2s,background .2s}.primary-button:hover{transform:translateY(-2px);background:var(--accent)}.about-strip{position:relative;overflow:hidden;display:flex;align-items:center;gap:28px;padding:34px 40px;margin:5px 0 85px;border:1px solid #e2ded4;border-radius:23px;background:linear-gradient(115deg,#e9e9df,#f0e7dc 70%,#f2e5db)}.about-mark{flex:0 0 auto;width:57px;height:57px;display:grid;place-items:center;border-radius:19px;background:var(--ink);color:#f7f1e8;font:800 32px Manrope,sans-serif;letter-spacing:-3px;padding:0 3px 5px 0}.about-strip h2{margin:8px 0 7px;max-width:510px;font:600 21px Manrope,sans-serif;letter-spacing:-.7px}.about-strip div>p:last-child{max-width:570px;margin:0;color:#777970;font-size:11px;line-height:1.8}.about-decoration{margin-left:auto;color:#b95f434d;font-size:76px;line-height:1;animation:slow-spin 24s linear infinite}.footer{min-height:78px;padding:20px 6%;border-top:1px solid #e3dfd6;display:flex;align-items:center;justify-content:space-between;gap:15px;color:#92938b;font-size:10px}.footer-brand{color:var(--ink);font-size:17px}.footer-year{font-variant-numeric:tabular-nums}.viewer{width:min(1120px,96vw);max-width:none;height:min(92vh,900px);max-height:94vh;padding:0;border:1px solid #ffffff21;border-radius:24px;overflow:hidden;background:#22231f;color:#f7f4ed;box-shadow:0 30px 100px #00000059}.viewer[open]{animation:viewer-enter .32s var(--ease)}.viewer::backdrop{background:#141512c7;backdrop-filter:blur(12px)}.viewer-top{position:absolute;z-index:2;inset:0 0 auto;height:65px;padding:0 24px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(#22231f,transparent)}.viewer-brand{font:800 17px Manrope,sans-serif;letter-spacing:-1px}.icon-button,.viewer-arrow{display:grid;place-items:center;border:1px solid #ffffff21;color:#f7f4ed;background:#ffffff14;cursor:pointer;backdrop-filter:blur(10px);transition:background .2s,transform .2s}.icon-button{width:38px;height:38px;border-radius:50%}.icon-button:hover,.viewer-arrow:hover:not(:disabled){background:#ffffff2e;transform:scale(1.05)}.icon-button svg,.viewer-arrow svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.viewer-content{height:100%;display:flex;flex-direction:column;justify-content:center;padding:68px 90px 30px}.viewer-image-wrap{flex:1;min-height:0;display:grid;place-items:center}.viewer-content img{display:block;max-width:100%;max-height:100%;object-fit:contain;border-radius:5px;animation:image-reveal .3s ease}.viewer-details{display:flex;align-items:end;justify-content:space-between;gap:20px;padding-top:22px}.viewer-kicker{margin:0 0 6px;color:#b7a99a;font-size:8px;font-weight:700;letter-spacing:1.8px}.viewer-details h2{margin:0;font:600 19px Manrope,sans-serif}.viewer-details p:last-child{margin:5px 0 0;color:#a5a59c;font-size:10px}.viewer-position{color:#a5a59c;font-size:10px;font-variant-numeric:tabular-nums}.viewer-arrow{position:absolute;z-index:3;top:50%;transform:translateY(-50%);width:43px;height:43px;border-radius:50%}.viewer-prev{left:23px}.viewer-next{right:23px}.viewer-arrow:disabled{opacity:.35;cursor:default}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}@keyframes card-enter{to{opacity:1;transform:translateY(0) scale(1)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes orbit-breathe{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-8px) rotate(4deg)}}@keyframes slow-spin{to{transform:rotate(360deg)}}@keyframes viewer-enter{from{opacity:0;transform:translateY(12px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes image-reveal{from{opacity:.5;transform:scale(.99)}to{opacity:1;transform:scale(1)}}@media(max-width:1050px){.gallery{columns:3 210px}.hero-aside{margin-right:4%}}@media(max-width:720px){.topbar{height:67px;padding-inline:6%}.live-indicator{font-size:8px;letter-spacing:1px}.topbar-right{gap:17px}.page-shell{width:88%}.hero{min-height:350px;padding:64px 0 58px}.hero h1{letter-spacing:-4px}.hero-aside{margin:18px 0 0}.hero-orbit{width:105px;height:105px}.orbit-core{width:44px;height:44px;border-radius:15px;font-size:22px}.hero-aside p{font-size:9px}.gallery{columns:2 150px;column-gap:13px}.photo-card{margin-bottom:14px}.photo-card-inner{border-radius:15px}.photo-card-info{padding:11px;display:block}.photo-date{display:block;margin-top:5px}.about-strip{padding:27px 24px;gap:18px}.about-decoration{font-size:48px}.viewer{width:100vw;height:100dvh;max-height:100dvh;border-radius:0}.viewer-content{padding:72px 52px 25px}.viewer-prev{left:9px}.viewer-next{right:9px}}@media(max-width:480px){.topbar{padding-inline:20px}.live-indicator{display:none}.page-shell{width:calc(100% - 38px)}.hero{min-height:315px;padding:55px 0 48px}.hero h1{font-size:clamp(52px,13vw,67px);letter-spacing:-3.8px}.hero-aside{display:none}.hero-description{max-width:290px;font-size:12px}.collection{padding-top:14px}.collection-heading{align-items:start;flex-direction:column;gap:9px}.collection-heading h2{font-size:23px}.toolbar{min-height:60px;padding:10px 12px;gap:8px}.search-box{width:100%;gap:8px}.search-box input{font-size:11px}.search-box kbd,.sort-label{display:none}.toolbar-right{gap:4px}.select-wrap select{max-width:103px;font-size:10px}.gallery{columns:2 130px;column-gap:10px}.photo-card{margin-bottom:11px}.photo-card-inner{border-radius:13px}.photo-title{font-size:11px}.photo-date{font-size:8px}.about-strip{margin-bottom:55px;padding:23px 19px;align-items:start}.about-mark{width:43px;height:43px;border-radius:14px;font-size:25px}.about-strip h2{font-size:17px}.about-strip div>p:last-child{font-size:10px}.about-decoration{display:none}.footer{padding:20px;font-size:9px}.viewer-content{padding:70px 40px 24px}.viewer-top{padding-inline:17px}.viewer-arrow{width:35px;height:35px}.viewer-prev{left:7px}.viewer-next{right:7px}.viewer-details h2{font-size:16px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
